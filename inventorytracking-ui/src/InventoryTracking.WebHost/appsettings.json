{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Viewer": {
    "SessionsDirectory": "session-data",
    "MaxFileBytes": 262144,
    "MaxFilesPerSession": 100,
    "MaxSessionBytes": 5242880,
    "MaxSessions": 5000,
    "MemoryIdleMinutes": 60,
    "SessionLifetimeDays": 7,
    "AllowedHosts": []
  }
}
