<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the in-process ASP.NET Core Module. dotnet publish fills in the launcher placeholders. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- Uploads are small: 20 export files of at most 256 KB per request, plus the form overhead. -->
          <requestLimits maxAllowedContentLength="5500000" />
          <!-- The session folder is never served by IIS itself. The name must not match a segment of an API address (/api/v1/sessions), or IIS answers those requests with 404. -->
          <hiddenSegments>
            <add segment="session-data" />
          </hiddenSegments>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
