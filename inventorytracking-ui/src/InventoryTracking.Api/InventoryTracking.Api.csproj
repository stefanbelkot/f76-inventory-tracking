<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Everything the local viewer and the web version share: the JSON API, sessions and uploads, the request
    guard and the embedded Vue app. It is a library (the Web SDK only provides the ASP.NET Core references); the
    hosts (the Windows exe and the IIS web app) call ViewerApp.AddViewer and ViewerApp.UseViewer.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>InventoryTracking.Server</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <WebDir>$(MSBuildThisFileDirectory)..\..\web\</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.10" />
    <ProjectReference Include="..\InventoryTracking.Core\InventoryTracking.Core.csproj" />
    <InternalsVisibleTo Include="InventoryTracking.Server.Tests" />
  </ItemGroup>

  <!--
    The Vue app is built into web\dist and embedded in this assembly under "wwwroot".
    The build runs only when index.html is missing or any web source is newer; set -p:SkipWebBuild=true to skip it.
  -->
  <ItemGroup>
    <WebInput Include="$(WebDir)src\**" />
    <WebInput Include="$(WebDir)index.html;$(WebDir)package.json;$(WebDir)package-lock.json;$(WebDir)vite.config.ts;$(WebDir)tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildWebUi" Inputs="@(WebInput)" Outputs="$(WebDir)dist\index.html" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
  </Target>

  <Target Name="EmbedWebUi" DependsOnTargets="BuildWebUi" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <WebDistFile Include="$(WebDir)dist\**" />
      <EmbeddedResource Include="@(WebDistFile)" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
