<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Windows executable: single instance, tray icon, browser launch and local folder access around the shared
    API library. It can run the viewer in local, web or both mode (command line flag mode); the IIS-only web build is InventoryTracking.WebHost.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>InventoryTrackingViewer</AssemblyName>
    <RootNamespace>InventoryTracking.Server</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Publishing with PublishSingleFile (see the README) produces one self-contained executable. -->
  <PropertyGroup>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryTracking.Api\InventoryTracking.Api.csproj" />
    <ProjectReference Include="..\InventoryTracking.Core\InventoryTracking.Core.csproj" />
    <InternalsVisibleTo Include="InventoryTracking.Server.Tests" />
  </ItemGroup>

</Project>
